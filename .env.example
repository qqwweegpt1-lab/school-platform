# انسخ هذا الملف إلى .env (أو عرّف المتغيرات في بيئة الخادم). لا تضع قيمًا سرية حقيقية في هذا الملف.

# المنفذ والعنوان
PORT=3000
HOST=127.0.0.1

# development | production
NODE_ENV=development

# مجلد البيانات (قاعدة SQLite والمرفقات). يجب أن يكون خارج مجلد public وغير متاح للويب.
DATA_DIR=./storage

# سر عشوائي طويل (32 بايت فأكثر) لاشتقاق مفاتيح التوقيع. أنشئه بالأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# اجعلها true عند النشر خلف HTTPS لتفعيل Secure على ملفات تعريف الارتباط وترويسة HSTS
COOKIE_SECURE=false

# اجعلها true فقط إذا كان الخادم خلف وكيل عكسي موثوق (nginx/Caddy) ليُقرأ عنوان IP من X-Forwarded-For
TRUST_PROXY=false

# الحد الأقصى لحجم المرفق الواحد (ميغابايت) وعدد المرفقات في الطلب
MAX_ATTACHMENT_MB=5
MAX_ATTACHMENTS=3

# حدود معدّل الإرسال (عدد الطلبات لكل عنوان IP في الساعة)
SUBMIT_LIMIT_PER_HOUR=20

# تُستخدم فقط عند تنفيذ: npm run create-admin  (يمكن إدخالها تفاعليًا بدل ذلك)
# ADMIN_USERNAME=
# ADMIN_DISPLAY_NAME=
# ADMIN_PASSWORD=
